# Domain pointing at this server (A/AAAA record). Caddy gets the HTTPS certificate automatically.
LUMI_DOMAIN=lumi.beyondex.io

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Invite-only by default; set to true to let anyone register.
ALLOW_SIGNUP=false

# Optional: enables the AI assistant, quick-add parsing, breakdown and summaries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Team accounts created by the seed script (Pouya, Amirhossein, Matin — in this order).
TEAM_EMAILS=pouya@beyondex.io,amirhossein@beyondex.io,matin@beyondex.io

BACKUP_KEEP_DAYS=14

# Use locally built images instead of the published ones:
# LUMI_API_IMAGE=lumi-api:local
# LUMI_WEB_IMAGE=lumi-web:local
