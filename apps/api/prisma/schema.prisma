// Lumi — Phase 1 data model. See docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
  VIEWER
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

enum StatusCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELED
}

enum ProposalState {
  NONE
  PROPOSED
  ACCEPTED
  DECLINED
}

enum AssigneeRole {
  ASSIGNEE
  REVIEWER
  WATCHER
}

enum DependencyType {
  BLOCKS
  RELATES
  DUPLICATES
}

enum CalendarSystem {
  jalali
  gregorian
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  locale       String         @default("fa")
  calendar     CalendarSystem @default(jalali)
  timezone     String         @default("Asia/Tehran")
  workHours    Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
  createdTasks  Task[]         @relation("TaskCreator")
  assignments   TaskAssignee[]
  comments      Comment[]
  notifications Notification[]
  timeEntries   TimeEntry[]
  savedViews    SavedView[]
  goals         Goal[]
  checkIns      CheckIn[]
  habits        Habit[]
  focusSessions FocusSession[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  teams       Team[]
  projects    Project[]
  labels      Label[]
  activities  Activity[]
  invites     Invite[]
  goals       Goal[]
  habits      Habit[]
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(MEMBER)
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

model Membership {
  userId      String
  workspaceId String
  role        Role      @default(MEMBER)
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

model Team {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    Project[]
}

model Project {
  id           String    @id @default(cuid())
  workspaceId  String
  teamId       String?
  key          String
  name         String
  icon         String?
  color        String?
  methodology  String[]  @default(["KANBAN"])
  settings     Json?
  taskCounter  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  statuses     Status[]
  tasks        Task[]
  fields       CustomField[]
  views        SavedView[]
  sprints      Sprint[]
  milestones   Milestone[]

  @@unique([workspaceId, key])
}

model Status {
  id        String         @id @default(cuid())
  projectId String
  name      String
  category  StatusCategory
  color     String
  order     Int
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Task {
  id            String        @id @default(cuid())
  projectId     String
  number        Int
  parentId      String?
  title         String
  description   Json?
  statusId      String
  priority      Priority      @default(NONE)
  storyPoints   Int?
  estimateMin   Int?
  startAt       DateTime?
  dueAt         DateTime?
  deadlineAt    DateTime?
  recurrence    String?
  createdById   String
  proposalState ProposalState @default(NONE)
  proposedDueAt DateTime?
  proposalNote  String?
  customFields  Json?
  orderKey      String
  completedAt   DateTime?
  archivedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       Task?            @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks     Task[]           @relation("Subtasks")
  status       Status           @relation(fields: [statusId], references: [id])
  createdBy    User             @relation("TaskCreator", fields: [createdById], references: [id])
  assignees    TaskAssignee[]
  labels       TaskLabel[]
  checklist    ChecklistItem[]
  comments     Comment[]
  attachments  Attachment[]
  dependencies TaskDependency[] @relation("DependencyFrom")
  dependents   TaskDependency[] @relation("DependencyTo")
  timeEntries  TimeEntry[]
  sprintId     String?
  sprint       Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestoneId  String?
  milestone    Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  keyResults   KeyResultTask[]
  focusSessions FocusSession[]

  @@unique([projectId, number])
  @@index([projectId, statusId, orderKey])
  @@index([dueAt])
  @@index([startAt])
}

model TaskAssignee {
  taskId String
  userId String
  role   AssigneeRole @default(ASSIGNEE)
  task   Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId, role])
}

model TaskDependency {
  fromTaskId String
  toTaskId   String
  type       DependencyType
  from       Task           @relation("DependencyFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  to         Task           @relation("DependencyTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@id([fromTaskId, toTaskId, type])
}

model Label {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  color       String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       TaskLabel[]
}

model TaskLabel {
  taskId  String
  labelId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model ChecklistItem {
  id     String  @id @default(cuid())
  taskId String
  text   String
  done   Boolean @default(false)
  order  Int
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Comment {
  id         String    @id @default(cuid())
  taskId     String
  authorId   String
  body       Json
  parentId   String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id])
  parent     Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("Replies")
}

model Attachment {
  id        String   @id @default(cuid())
  taskId    String
  key       String
  name      String
  mime      String
  size      Int
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String
  entity      String
  entityId    String
  action      String
  diff        Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entity, entityId])
}

model Notification {
  id           String    @id @default(cuid())
  userId       String
  type         String
  payload      Json
  readAt       DateTime?
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

enum FieldType {
  TEXT
  NUMBER
  MONEY
  DATE
  SELECT
  MULTI_SELECT
  USER
  CHECKBOX
  URL
  PROGRESS
  RATING
}

enum ViewType {
  LIST
  BOARD
  TABLE
  CALENDAR
  TIMELINE
}

/// Per-project field definition; values live in Task.customFields keyed by field id.
model CustomField {
  id        String    @id @default(cuid())
  projectId String
  name      String
  type      FieldType
  /// SELECT/MULTI_SELECT: [{ id, name, color }]; MONEY: { currency }
  options   Json?
  order     Int
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Named filter/sort/group configuration of a project view, personal or shared.
model SavedView {
  id        String   @id @default(cuid())
  projectId String
  ownerId   String
  name      String
  type      ViewType
  config    Json
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

/// A running timer has endedAt = null; at most one per user.
model TimeEntry {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  startedAt DateTime
  endedAt   DateTime?
  minutes   Int?
  note      String?
  billable  Boolean   @default(false)
  createdAt DateTime  @default(now())
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([taskId])
}

enum SprintState {
  PLANNED
  ACTIVE
  COMPLETED
}

model Sprint {
  id          String      @id @default(cuid())
  projectId   String
  name        String
  goal        String?
  startAt     DateTime
  endAt       DateTime
  state       SprintState @default(PLANNED)
  /// { wentWell: string[], improve: string[], actions: string[] }
  retro       Json?
  /// Points/tasks committed and completed, frozen when the sprint completes.
  summary     Json?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId, state])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueAt       DateTime
  color       String?
  doneAt      DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

enum KeyResultType {
  NUMBER
  PERCENT
  CURRENCY
  TASKS
}

/// OKR objective; period like "1405-Q3".
model Goal {
  id          String      @id @default(cuid())
  workspaceId String
  ownerId     String
  parentId    String?
  title       String
  description String?
  period      String
  emoji       String?
  createdAt   DateTime    @default(now())
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User        @relation(fields: [ownerId], references: [id])
  parent      Goal?       @relation("GoalTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Goal[]      @relation("GoalTree")
  keyResults  KeyResult[]
}

model KeyResult {
  id        String          @id @default(cuid())
  goalId    String
  title     String
  type      KeyResultType   @default(NUMBER)
  start     Float           @default(0)
  target    Float
  current   Float           @default(0)
  unit      String?
  order     Int             @default(0)
  goal      Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks     KeyResultTask[]
  checkIns  CheckIn[]
}

model KeyResultTask {
  keyResultId String
  taskId      String
  keyResult   KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([keyResultId, taskId])
}

model CheckIn {
  id          String    @id @default(cuid())
  keyResultId String
  userId      String
  value       Float
  /// 1–10 confidence that the KR will be hit.
  confidence  Int
  note        String?
  createdAt   DateTime  @default(now())
  keyResult   KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Habit {
  id          String     @id @default(cuid())
  userId      String
  workspaceId String
  title       String
  emoji       String?
  color       String?
  /// Days of week (JS getDay) the habit is due; empty = every day.
  days        Int[]      @default([])
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs        HabitLog[]
}

model HabitLog {
  habitId String
  /// Local calendar day as YYYY-MM-DD.
  day     String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([habitId, day])
}

enum FocusKind {
  FOCUS
  SHORT_BREAK
  LONG_BREAK
}

model FocusSession {
  id         String    @id @default(cuid())
  userId     String
  taskId     String?
  kind       FocusKind @default(FOCUS)
  plannedMin Int
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  completed  Boolean   @default(false)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
}
